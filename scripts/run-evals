#!/usr/bin/env bash
# This repo's shortcut: scripts/run-evals <skill name> <out dir> [eval id...]. The runner itself ships with skill-evals.
exec "$(dirname "$(realpath "$0")")/../skills/skill-evals/scripts/run-evals" "$(dirname "$(realpath "$0")")/../skills/${1:?usage: run-evals <skill> <out dir> [eval id...]}" "${@:2}"
