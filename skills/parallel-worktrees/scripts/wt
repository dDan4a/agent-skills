#!/bin/bash
# Task worktrees: one git worktree per task, so parallel agent sessions never share a checkout. A repo's
# worktrees live next to it, in <dir>/.worktrees/<repo>/<branch> (<dir> holds the main checkout <dir>/<repo>),
# and are removed once their branch is merged.
#
#   wt new <repo> <branch> [--agent claude|codex] [--role NAME] [--brief FILE|-] [--focus]
#                            create the task worktree from the repo's base branch; <repo> is the repo's path
#                            (`.` inside it), the name of a repo next to the current one, or <group>/<repo>
#                            under $WT_ROOT
#                            --agent starts a new agent session there (Herdr only) and hands it the brief
#                            --role runs that Claude session as `claude --agent NAME` (.claude/agents/NAME.md)
#   wt clean [path]          remove that worktree if its branch is merged
#   wt clean --all [dir]     same for every task worktree of the project
#   wt sync [dir] [--dry-run]
#                            per repo: fetch once, fast-forward the local base branch, prune stale
#                            worktrees, remove merged ones and report on every task worktree
#   wt list [dir]            every task worktree of the project
#   wt hook                  Claude Code SessionEnd hook: `wt clean` for the session's cwd and the same
#                            task's worktrees in the project's other repos
#
# The project is the folder holding the main checkouts and .worktrees: [dir], else the one of the current
# directory. With $WT_ROOT set (projects laid out as $WT_ROOT/<group>/<repo>), [dir] may be a group, and
# outside a project sync, list and clean --all cover every group.
#
# Settings are local to each machine, kept out of git, and optional: <project>/.wt.conf (one for all the
# project's repos; link_local_files can `case $repo`), then <repo>/.wt.conf in the main checkout, which
# overrides it. Both are bash and may set:
#   BASE=master              base branch (default: the remote's HEAD branch)
#   REMOTE=origin            remote to branch from and check merges against
#   INTEGRATION=dev          a branch merged before BASE, only for the report
#   TASK_RE='PROJ-[0-9]+'    task id in branch names (<id>.<desc>): `wt hook` also cleans that task in other repos
#   link_local_files() { repo=$1 src=$2 dst=$3; ... }   untracked files each checkout needs
set -uo pipefail

SYNC=0 DRY_RUN=0 NO_FETCH=0
REPO="" WT_DIR="" BASE="" REMOTE=origin INTEGRATION="" TASK_RE="" PROJECTS=()

say() { echo "wt: $*" >&2; }
notify() { command -v notify-send >/dev/null && notify-send -a "Worktrees" "$1" "${2:-}"; say "$1 ${2:-}"; }
abspath() { (cd "$1" 2>/dev/null && pwd -P); }
# GNU timeout where there is one (stock macOS has none).
maybe_timeout() { if command -v timeout >/dev/null; then timeout "$@"; else shift; "$@"; fi; }

ROOT=""; [ -n "${WT_ROOT:-}" ] && ROOT=$(abspath "$WT_ROOT")

# main_of <path>: the main checkout of the repo or worktree at path.
main_of() { local d; d=$(git -C "$1" rev-parse --path-format=absolute --git-common-dir 2>/dev/null) && dirname "$d"; }

# load_repo <main checkout>: sets REPO, WT_DIR and the repo's settings: the project's .wt.conf, then the
# repo's own one from the main checkout.
load_repo() {
  REPO=$(basename "$1") WT_DIR="$(dirname "$1")/.worktrees"
  BASE="" REMOTE=origin INTEGRATION="" TASK_RE=""
  link_local_files() { :; }
  [ -f "$(dirname "$1")/.wt.conf" ] && . "$(dirname "$1")/.wt.conf"
  [ -f "$1/.wt.conf" ] && . "$1/.wt.conf"
  return 0
}

# project_of <dir>: the project dir is in, the parent of the first repo or worktree found going up, or a folder
# with .worktrees. Stops at $WT_ROOT, which may be a repo itself.
project_of() {
  local d; d=$(abspath "$1") || return 1
  while [ "$d" != / ] && [ "$d" != "$ROOT" ]; do
    [ -e "$d/.git" ] && { d=$(main_of "$d") && dirname "$d"; return; }
    [ -d "$d/.worktrees" ] && { echo "$d"; return; }
    d=$(dirname "$d")
  done
  return 1
}

# projects [dir]: sets PROJECTS, what sync, list and clean --all work on.
projects() {
  local d=${1:-.} p
  [ -n "${1:-}" ] && [ ! -d "$d" ] && [ -n "$ROOT" ] && d=$ROOT/$1       # a group under $WT_ROOT
  [ -d "$d" ] || { say "no directory $1"; exit 1; }
  if p=$(project_of "$d"); then PROJECTS=("$p")
  elif [ -n "$ROOT" ] && { [ -z "${1:-}" ] || [ "$(abspath "$d")" = "$ROOT" ]; }; then
    PROJECTS=(); for p in "$ROOT"/*/; do PROJECTS+=("${p%/}"); done
  else say "no project at $d: run inside a repo or name the folder that holds its .worktrees"; exit 1; fi
}

# repo_dir <spec>: the main checkout `wt new` works on.
repo_dir() {
  local here d
  here=$(project_of .) || here=""
  for d in "$1" ${here:+"$here/$1"} ${ROOT:+"$ROOT/$1"}; do
    [ -e "$d/.git" ] && { main_of "$d"; return; }
  done
  return 1
}

# base_of <repo dir>: the branch tasks start from and merge into.
base_of() {
  [ -n "$BASE" ] && { echo "$BASE"; return; }
  local head
  head=$(git -C "$1" symbolic-ref --quiet --short "refs/remotes/$REMOTE/HEAD" 2>/dev/null) ||
    head=$(git -C "$1" remote set-head "$REMOTE" --auto >/dev/null 2>&1 && git -C "$1" symbolic-ref --quiet --short "refs/remotes/$REMOTE/HEAD")
  echo "${head#"$REMOTE"/}"
}

cmd_new() {
  local spec=${1:?usage: wt new <repo> <branch>} branch=${2:?usage: wt new <repo> <branch>}; shift 2
  local agent="" role="" brief="" focus=--no-focus
  while [ $# -gt 0 ]; do
    case $1 in
      --agent) agent=${2:?--agent needs claude or codex}; shift 2 ;;
      --role) role=${2:?--role needs a name}; shift 2 ;;
      --brief) brief=${2:?--brief needs a file or -}; shift 2 ;;
      --focus) focus=--focus; shift ;;
      *) say "unknown option $1"; exit 1 ;;
    esac
  done
  if [ -n "$role" ]; then
    [[ $role =~ ^[a-z][a-z0-9-]*$ ]] || { say "bad role name '$role': lowercase letters, digits and '-', starting with a letter"; exit 1; }
    [ -n "$agent" ] || { say "--role needs --agent claude"; exit 1; }
    [ "$agent" = claude ] || { say "roles are Claude Code only (--agent claude)"; exit 1; }
  fi
  local src
  src=$(repo_dir "$spec") || { say "no repo '$spec': give its path (. inside it), a repo next to this one or <group>/<repo> under \$WT_ROOT"; exit 1; }
  load_repo "$src"
  local dst="$WT_DIR/$REPO/$branch"
  [ -e "$dst" ] && { say "already exists: $dst"; echo "$dst"; exit 0; }
  [ -n "$agent" ] && [ "${HERDR_ENV:-}" != 1 ] && { say "--agent needs Herdr (HERDR_ENV=1)"; exit 1; }

  local base; base=$(base_of "$src")
  [ -n "$base" ] || { say "cannot tell the base branch of $src; set BASE in .wt.conf"; exit 1; }
  git -C "$src" fetch --quiet "$REMOTE" "$base" || say "fetch failed, using local $REMOTE/$base"
  mkdir -p "$(dirname "$dst")"
  local pane=""
  if [ "${HERDR_ENV:-}" = 1 ]; then
    local out
    out=$(herdr worktree create --cwd "$src" --branch "$branch" --base "$REMOTE/$base" --path "$dst" --label "$branch" $focus) || exit 1
    pane=$(jq -r '.result.root_pane.pane_id // empty' <<<"$out")
  else
    git -C "$src" worktree add --no-track -b "$branch" "$dst" "$REMOTE/$base" >&2 || exit 1
  fi
  link_local_files "$REPO" "$src" "$dst"
  echo "$dst"

  [ -n "$agent" ] || return 0
  local text=""
  if [ "$brief" = - ]; then text=$(cat); elif [ -n "$brief" ]; then text=$(cat "$brief"); fi

  # Herdr agent names: lowercase letters, digits, '-', '_', starting with a letter, max 32.
  local name
  name=$(tr 'A-Z' 'a-z' <<<"$branch" | sed 's/[^a-z0-9_-]/-/g; s/^[^a-z]*//' | cut -c1-32)
  local args=()
  # Factory roles never push or touch PRs: agent-desk does that. Each rule twice, as the rtk hook rewrites
  # `git push` to `rtk git push` before the permission check and a plain rule does not match it.
  local banned=() cmd
  for cmd in "git push" "gh pr create" "gh pr merge" "gh pr ready"; do banned+=("Bash($cmd *)" "Bash(rtk $cmd *)"); done
  [ -n "$role" ] && args=(-- --agent "$role" --permission-mode auto --disallowedTools "${banned[@]}")
  herdr agent start "${name:-task}" --kind "$agent" --pane "$pane" ${args[@]+"${args[@]}"} >/dev/null || { say "agent did not start in $pane"; exit 1; }
  # The brief goes inline: a file outside the worktree would cost the new session a permission prompt.
  local prompt="You are continuing task $branch in its own git worktree ($dst), handed off from another session."
  [ -n "$text" ] && prompt=$(printf '%s Handoff brief:\n\n%s' "$prompt" "$text")
  herdr agent prompt "${name:-task}" "$prompt" >/dev/null || say "agent started but the prompt was not delivered"
  say "agent '${name:-task}' started in Herdr pane $pane"
}

# removed|skipped|kept <branch> <detail>: a line in `wt sync`, a desktop notification otherwise.
report() {
  if [ "$SYNC" = 1 ]; then
    local mark="•"; case $1 in removed) mark="✔" ;; skipped) mark="⚠" ;; esac
    printf '  %s %-45s %s\n' "$mark" "$2" "$3"
  else
    case $1 in
      removed) notify "$2 merged, worktree removed" ;;
      skipped) notify "$2 merged but has uncommitted changes" "$3: kept" ;;
      kept) say "$2 kept: $3" ;;
    esac
  fi
}

# Remove one task worktree if its branch reached the base branch.
clean_one() {
  local top branch main base
  top=$(git -C "$1" rev-parse --show-toplevel 2>/dev/null) && main=$(main_of "$top") || return 0
  load_repo "$main"
  case $top in "$WT_DIR/$REPO"/*) ;; *) return 0 ;; esac        # only task worktrees
  branch=$(git -C "$top" branch --show-current)
  # A detached HEAD hides which branch the work belongs to (and commits made there may be on no branch): say so.
  [ -n "$branch" ] || { report kept "${top#"$WT_DIR"/}" "detached HEAD at $(git -C "$top" rev-parse --short HEAD), switch to its branch"; return 0; }
  base=$(base_of "$main")
  [ -n "$base" ] || return 0

  [ "$NO_FETCH" = 1 ] || maybe_timeout 20 git -C "$main" fetch --quiet --prune "$REMOTE" 2>/dev/null
  # A branch with no commits yet is also "contained" in the base; skip it.
  if [ "$(git -C "$main" reflog show --format=%H "refs/heads/$branch" -- | tail -1)" = "$(git -C "$main" rev-parse "refs/heads/$branch")" ]; then
    report kept "$branch" "no commits yet"; return 0
  fi
  local merged=0
  git -C "$main" merge-base --is-ancestor "refs/heads/$branch" "$REMOTE/$base" && merged=1
  # Squash merges leave no ancestry: squash the branch onto its merge base and ask whether the base already
  # has an equivalent patch.
  if [ "$merged" = 0 ]; then
    local mb squashed
    mb=$(git -C "$main" merge-base "$REMOTE/$base" "refs/heads/$branch") &&
      squashed=$(git -C "$main" commit-tree "refs/heads/$branch^{tree}" -p "$mb" -m squash) &&
      [[ $(git -C "$main" cherry "$REMOTE/$base" "$squashed") == -* ]] && merged=1
  fi
  if [ "$merged" = 0 ]; then
    if [ -n "$INTEGRATION" ] && git -C "$main" merge-base --is-ancestor "refs/heads/$branch" "$REMOTE/$INTEGRATION" 2>/dev/null; then
      report kept "$branch" "in $INTEGRATION, not in $base yet"
    else report kept "$branch" "not merged"; fi
    return 0
  fi
  if [ -n "$(git -C "$top" status --porcelain)" ]; then
    report skipped "$branch" "$top"; return 0
  fi
  local ws="" busy
  command -v herdr >/dev/null &&
    ws=$(herdr worktree list --cwd "$main" 2>/dev/null | jq -r --arg p "$top" '.result.worktrees[] | select(.path == $p) | .open_workspace_id // empty')
  # Removing the workspace kills its agents: leave it while one is mid-task. The caller's own pane is excluded,
  # it is the session ending (hook) or the coordinator itself.
  if [ -n "$ws" ]; then
    busy=$(herdr agent list 2>/dev/null | jq -r --arg ws "$ws" --arg me "${HERDR_PANE_ID:-}" '[.result.agents[]? |
      select(.workspace_id == $ws and .pane_id != $me and .agent_status != "idle" and .agent_status != "done") |
      "agent \(.name // .agent) is \(.agent_status)"] | first // empty')
    [ -n "$busy" ] && { report kept "$branch" "merged, $busy"; return 0; }
  fi
  [ "$DRY_RUN" = 1 ] && { report kept "$branch" "merged → would remove"; return 0; }

  # A branch like `fix/foo` leaves `<repo>/fix/` behind: remove such parents once empty, deepest first, but
  # never `<repo>` itself.
  local parents=() d
  d=$(dirname "$top")
  while [[ $d == "$WT_DIR"/*/* ]]; do parents+=("$d"); d=$(dirname "$d"); done
  if [ -n "$ws" ] && [ "$ws" = "${HERDR_WORKSPACE_ID:-}" ]; then
    # Detached and delayed: the caller (the SessionEnd hook) runs inside that workspace's own pane.
    local detach=nohup; command -v setsid >/dev/null && detach=setsid
    $detach bash -c "sleep 2; herdr worktree remove --workspace '$ws' --force >/dev/null 2>&1 || git -C '$main' worktree remove --force '$top'; git -C '$main' branch -D '$branch' >/dev/null; rmdir $(printf '%q ' ${parents[@]+"${parents[@]}"}) 2>/dev/null; $(printf '%q' "$(abspath "$(dirname "$0")")/$(basename "$0")") close-main '$main'" </dev/null >/dev/null 2>&1 &
  else
    # -D: a squash-merged branch is not an ancestor, but the checks above showed it is merged.
    { [ -n "$ws" ] && herdr worktree remove --workspace "$ws" --force >/dev/null 2>&1; } || git -C "$main" worktree remove --force "$top" ||
      { report kept "$branch" "merged, removing the worktree failed"; return 0; }
    git -C "$main" branch -D "$branch" >/dev/null
    [ ${#parents[@]} -gt 0 ] && rmdir "${parents[@]}" 2>/dev/null
    close_main_ws "$main"
  fi
  report removed "$branch" "merged, removed"
}

# close_main_ws <main checkout>: `herdr worktree create` also opens a workspace for the repo itself. Close it
# once the repo's last task worktree is gone and nothing runs there: not the caller's workspace, no agent, every
# pane at its shell prompt. Closing it earlier would also close the linked task workspaces.
close_main_ws() {
  local main=$1 ws p fg
  command -v herdr >/dev/null || return 0
  [ "$(git -C "$main" worktree list --porcelain | grep -c '^worktree ')" = 1 ] || return 0
  ws=$(herdr worktree list --cwd "$main" 2>/dev/null | jq -r '.result.source.source_workspace_id // empty')
  [ -n "$ws" ] && [ "$ws" != "${HERDR_WORKSPACE_ID:-}" ] || return 0
  [ "$(herdr pane list --workspace "$ws" 2>/dev/null | jq '[.result.panes[] | select(.agent != null)] | length')" = 0 ] || return 0
  for p in $(herdr pane list --workspace "$ws" | jq -r '.result.panes[].pane_id'); do
    fg=$(herdr pane process-info --pane "$p" 2>/dev/null |
      jq -r '.result.process_info | .foreground_process_group_id == .shell_pid') || return 0
    [ "$fg" = true ] || return 0
  done
  herdr workspace close "$ws" >/dev/null 2>&1
}

# worktrees <project>: every task worktree directory. Found by its `.git` file, not by depth: a branch like
# `fix/foo` lives one level deeper (`<repo>/fix/foo`).
worktrees() { find "$1/.worktrees" -maxdepth 8 -name .git -type f 2>/dev/null | sed 's|/\.git$||' | sort; }

cmd_clean() {
  if [ "${1:-}" = --all ]; then
    projects "${2:-}"
    local p d; for p in "${PROJECTS[@]}"; do while read -r d; do clean_one "$d"; done < <(worktrees "$p"); done
  else
    clean_one "${1:-.}"
  fi
}

cmd_list() {
  projects "${1:-}"
  local p d n
  for p in "${PROJECTS[@]}"; do
    while read -r d; do
      n=$(git -C "$d" status --porcelain 2>/dev/null | wc -l | tr -d ' ')
      [ "$n" = 0 ] && n="" || n="$n uncommitted"
      printf '%-60s %s\n' "${d#"$(dirname "$p")"/}" "$n"
    done < <(worktrees "$p")
  done
}

# SessionEnd: clean the session's worktree and every other worktree of the same task in the project
# (a session in one repo may also have opened the task's worktree in another repo, where no session ends).
cmd_hook() {
  local cwd top main rel own="" task="" wt_dir d
  cwd=$(jq -r '.cwd // empty'); [ -n "$cwd" ] && [ -d "$cwd" ] || return 0
  # Read the task before clean_one removes the worktree.
  if top=$(git -C "$cwd" rev-parse --show-toplevel 2>/dev/null) && main=$(main_of "$top"); then
    load_repo "$main"
    rel=${top#"$WT_DIR"/}
    if [ -n "$TASK_RE" ] && [ "$rel" != "$top" ]; then
      wt_dir=$WT_DIR own="$WT_DIR/$(cut -d/ -f1-2 <<<"$rel")"
      task=$(cut -d/ -f2 <<<"$rel" | grep -oE "^$TASK_RE") || task=""
    fi
  fi
  clean_one "$cwd"
  [ -n "$task" ] || return 0
  for d in "$wt_dir"/*/"$task".*/; do
    [ -d "$d" ] && [ "${d%/}" != "$own" ] && clean_one "${d%/}"
  done
}

cmd_sync() {
  local only="" a
  for a in "$@"; do case $a in --dry-run) DRY_RUN=1 ;; *) only=$a ;; esac; done
  SYNC=1 NO_FETCH=1
  projects "$only"
  local p src base d
  for p in "${PROJECTS[@]}"; do for src in "$p"/*/; do
    src=${src%/}; [ -d "$src/.git" ] || continue
    load_repo "$src"
    # Only projects that use task worktrees.
    [ -d "$WT_DIR" ] || continue
    echo "$(basename "$p")/$REPO"
    maybe_timeout 30 git -C "$src" fetch --quiet --prune "$REMOTE" || echo "  ! fetch failed, using cached $REMOTE/*"
    base=$(base_of "$src")
    # Fast-forward only; git refuses to move a branch that is checked out in some worktree.
    if [ "$(git -C "$src" branch --show-current)" = "$base" ]; then
      # The main checkout itself stands on the base branch: fast-forward it when clean.
      if [ -n "$(git -C "$src" status --porcelain --untracked-files=no)" ]; then echo "  ! $REPO has uncommitted changes, $base not updated"
      elif [ "$DRY_RUN" = 1 ]; then echo "  • would fast-forward $base"
      elif git -C "$src" merge --ff-only --quiet "$REMOTE/$base" 2>/dev/null; then echo "  ✔ $base = $REMOTE/$base"
      else echo "  ! local $base has its own commits, left as is"; fi
    elif git -C "$src" worktree list --porcelain | grep -qx "branch refs/heads/$base"; then
      echo "  • local $base is checked out in a worktree, not updated"
    elif git -C "$src" show-ref -q --verify "refs/heads/$base"; then
      if [ "$DRY_RUN" = 1 ]; then echo "  • would fast-forward local $base"
      elif git -C "$src" fetch --quiet . "$REMOTE/$base:$base" 2>/dev/null; then echo "  ✔ local $base = $REMOTE/$base"
      else echo "  ! local $base has its own commits, left as is"; fi
    fi
    [ "$DRY_RUN" = 1 ] || git -C "$src" worktree prune
    while read -r d; do clean_one "$d"; done < <(worktrees "$p" | grep -F "$WT_DIR/$REPO/")
  done; done
  return 0
}

case ${1:-} in
  sync)  shift; cmd_sync "$@" ;;
  new)   shift; cmd_new "$@" ;;
  clean) shift; cmd_clean "$@" ;;
  list)  shift; cmd_list "$@" ;;
  hook)  cmd_hook; exit 0 ;;
  close-main) close_main_ws "$2" ;;   # internal: the delayed Herdr removal calls it after the worktree is gone
  *)     sed -n '2,32p' "$0"; [ $# -eq 0 ] ;;   # bare `wt` is help, not an error
esac
